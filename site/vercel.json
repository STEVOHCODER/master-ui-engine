{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/library", "destination": "/library.html" },
    { "source": "/templates", "destination": "/templates.html" },
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/agents", "destination": "/agents.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=86400" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
