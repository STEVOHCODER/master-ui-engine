{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/library", "destination": "/library.html" },
    { "source": "/templates", "destination": "/templates.html" },
    { "source": "/preview", "destination": "/preview.html" },
    { "source": "/agents", "destination": "/agents.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.masterinterface.xyz" }],
      "destination": "https://masterinterface.xyz/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "master-ui-engine.vercel.app" }],
      "destination": "https://masterinterface.xyz/$1",
      "permanent": true
    },
    { "source": "/analytics", "destination": "/admin", "permanent": false },
    { "source": "/analytics.html", "destination": "/admin", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/engine/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, s-maxage=86400" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
