{
  "name": "mue-web-components",
  "version": "0.1.0",
  "description": "Zero-dependency Web Components bindings for MASTER-UI-ENGINE. Light DOM custom elements that apply the shared styles/components.css classes — no shadow root, no build step, no runtime dependency.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./registry.js": "./registry.js",
    "./components/": "./components/"
  },
  "files": [
    "index.js",
    "registry.js",
    "components/",
    "README.md"
  ],
  "keywords": [
    "web-components",
    "custom-elements",
    "design-system",
    "master-ui-engine",
    "light-dom",
    "no-build"
  ],
  "license": "MIT",
  "author": "MASTER-UI-ENGINE contributors",
  "repository": {
    "type": "git",
    "url": "MASTER-UI-ENGINE/frameworks/web-components"
  },
  "sideEffects": [
    "./index.js",
    "./components/*.js"
  ],
  "dependencies": {}
}
